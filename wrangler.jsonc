// Configuración de Cloudflare Workers. Ver docs/INSTALACION.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "programacion-cursos",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Archivos de la interfaz (HTML, CSS, JS). Las rutas /api/* pasan por el Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Base de datos (cursos, usuarios, ajustes). Cloudflare la crea sola en el primer despliegue.
  "d1_databases": [{ "binding": "DB", "database_name": "programacion-cursos" }],

  // Almacenamiento de las imágenes generadas. También se crea solo en el primer despliegue.
  "r2_buckets": [{ "binding": "IMAGENES", "bucket_name": "programacion-cursos-imagenes" }],

  // ADMIN_INICIAL, ACCESS_TEAM_DOMAIN, ACCESS_AUD y la llave GEMINI_API_KEY se configuran
  // en el panel de Cloudflare (Worker > Settings > Variables and Secrets), no aquí.
  // keep_vars evita que un despliegue las borre. Ver docs/INSTALACION.md.
  "keep_vars": true,
  "vars": {
    // Modelo de Google Gemini que genera las imágenes. Cámbialo si Google lo retira.
    "GEMINI_MODEL": "gemini-2.5-flash-image",
    // Costo aproximado por imagen en dólares, solo para el contador de uso.
    "COSTO_IMAGEN_USD": "0.039"
  },

  "observability": { "enabled": true }
}
