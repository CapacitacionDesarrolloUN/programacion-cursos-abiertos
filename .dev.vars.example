# Copia este archivo como .dev.vars para probar la app en tu computador (npm run dev).
# Contraseñas iniciales solo para pruebas locales.
CLAVE_ADMIN=admin-local
CLAVE_DISENADOR=disenador-local
# Sin llave de Google, genera una imagen gris de prueba y no gasta créditos.
IMAGEN_DE_PRUEBA=1
